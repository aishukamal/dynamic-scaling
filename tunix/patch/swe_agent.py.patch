+_TERSE_TEXT = (
+    "Response style: reply with the tool call only, preceded by at most one short sentence. Do not restate the task,"
+    " do not write plans or summaries, do not explain what you are about to do."
+)
+_DUMP_FH = None
 
+
+def _dump(rec: dict) -> None:
+  """Append one JSON record per model turn / env turn to TRAJ_DUMP_DIR/turns-<pid>.jsonl (hostPath on the rollout node)."""
+  global _DUMP_FH
+  if not _TRAJ_DUMP_DIR:
+    return
+  try:
+    if _DUMP_FH is None:
+      os.makedirs(_TRAJ_DUMP_DIR, exist_ok=True)
+      _DUMP_FH = open(os.path.join(_TRAJ_DUMP_DIR, f"turns-{os.getpid()}.jsonl"), "a", buffering=1)
+    rec["t"] = _time.time()
+    _DUMP_FH.write(_json.dumps(rec, ensure_ascii=False, default=str) + "\n")
+  except Exception:  # noqa: BLE001
+    pass
+
+
+def _qwen_json_system_prompt(base: str) -> str:
+  out = base.rstrip() + "\n\n" + _r2tc.tools_block()
+  if _TERSE_PROMPT:
+    out += "\n\n" + _TERSE_TEXT
+  return out
+
+
+def _strip_think(text: str) -> str:
+  if "</think>" in text:
+    return text.split("</think>", 1)[1].lstrip("\n")
+  return text
+# ---------------------------------------------------------------- end additions
+
